{#
  One spoke's entry in the AutoShift per-cluster values file
  (clusters.<cluster_name>). The managed clusterset (autoshift/clustersets/managed.yaml)
  carries everything that is the same on every spoke; this carries what differs.
  AutoShift merges cluster config over clusterset config key by key, but a list
  here REPLACES the clusterset's list, so every list below is complete.
  Nothing secret: AutoShift renders this into ConfigMaps on the hub.
#}
{% set le = (acme_ca == 'letsencrypt' or cluster_platform == 'aws') %}
{% set odf_ext = ('odf-external' in cluster_special_feature) %}
{% set metal = (cluster_platform == 'metal') %}
labels:
  # Node time sources (config.chrony below); the Machine Config Operator rolls the nodes once.
  chrony: 'true'
{% if metallb_network %}
  metallb: 'true'
  metallb-config: 'true'
{% endif %}
{% if metal and odf_ext %}
  # ODF in external mode against the lab Ceph (the 5.0 catalog only carries stable-4.22).
  odf: 'true'
  odf-external: 'true'
  odf-external-mcg: ignore
  odf-channel: stable-4.22
  odf-csi-all-nodes: 'true'
{% endif %}
config:
  chrony:
{% if cluster_platform == 'openstack' %}
    # Virtual machines on the lab cloud follow the hypervisor clock.
    ptpKvm: true
    servers: []
{% elif cluster_platform == 'aws' %}
    servers: ["169.254.169.123"]
{% else %}
    servers: {{ cluster_ntp_sources | to_json }}
{% endif %}
{% if metallb_network %}
  metallb:
    ipAddressPools:
      cluster-bgp-pool:
        addresses:
          - "{{ metallb_network.value.prefix }}"
      anycast-bgp-pool:
        addresses:
          - 172.18.71.0/24
        autoAssign: false
    bgpPeers:
      peer-lab-rtr-a:
        myASN: {{ metallb_asn }}
        peerASN: 65002
        peerAddress: 172.18.16.2
        peerPort: 179
      peer-lab-rtr-b:
        myASN: {{ metallb_asn }}
        peerASN: 65002
        peerAddress: 172.18.16.3
        peerPort: 179
    bgpAdvertisements:
      external:
        ipAddressPools: [cluster-bgp-pool, anycast-bgp-pool]
        peers: [peer-lab-rtr-a, peer-lab-rtr-b]
{% endif %}
  clusterSet: "{{ gitops_autoshift_cluster_set }}"
  externalSecretsOperator:
    clusterSecretStores:
      vault:
        provider:
          vault:
            auth:
              kubernetes:
                mountPath: "{{ hashicorp_vault['vault_managed_auth_name'] }}"
    externalSecrets:
{% if le and cluster_platform != 'aws' %}
      - name: route53-key
        namespace: cert-manager
        spec:
          refreshInterval: 1h
          secretStoreRef: {kind: ClusterSecretStore, name: vault}
          target: {name: route53-key, creationPolicy: Owner}
          dataFrom:
            - extract: {key: "{{ hashicorp_vault['cluster_secrets']['cert-manager-route53'] }}"}
{% elif not le %}
      - name: tsig-key
        namespace: cert-manager
        spec:
          refreshInterval: 1h
          secretStoreRef: {kind: ClusterSecretStore, name: vault}
          target: {name: tsig-key, creationPolicy: Owner}
          dataFrom:
            - extract: {key: "{{ hashicorp_vault['cluster_secrets']['cert-manager-tsig'] }}"}
{% endif %}
{% if metal and odf_ext %}
      - name: rook-ceph-external-cluster-details
        namespace: openshift-storage
        spec:
          refreshInterval: 1h
          secretStoreRef: {kind: ClusterSecretStore, name: vault}
          target: {name: rook-ceph-external-cluster-details, creationPolicy: Owner}
          dataFrom:
            - extract: {key: "{{ hashicorp_vault['cluster_secrets']['odf'] }}"}
{% endif %}
      - name: oidc-client-secret
        namespace: openshift-config
        spec:
          refreshInterval: 1h
          secretStoreRef: {kind: ClusterSecretStore, name: vault}
          target: {name: oidc-client-secret, creationPolicy: Owner}
          dataFrom:
            - extract: {key: "{{ hashicorp_vault['cluster_secrets']['oidc'] }}"}
  certManager:
    operatorConfig:
      controllerConfig:
        overrideArgs:
          - '--dns01-recursive-nameservers-only'
{% if le %}
          - '--dns01-recursive-nameservers=8.8.8.8:53,1.1.1.1:53'
{% else %}
          - '--dns01-recursive-nameservers=172.18.42.10:53'
{% endif %}
{% if cluster_platform == 'aws' %}
    # AWS: Route 53 through the cluster's ambient (STS) credentials, for this cluster's zone.
    clusterIssuers:
      letsencrypt:
        acme:
          solvers:
            - dns01:
                route53:
                  region: us-east-1
              selector:
                dnsZones:
                  - "{{ base_domain }}"
{% endif %}
    apiCert:
      issuer:
        name: "{{ 'letsencrypt' if le else 'lab-vault-acme' }}"
        kind: ClusterIssuer
        group: cert-manager.io
    ingressCert:
      issuer:
        name: "{{ 'letsencrypt' if le else 'lab-vault-acme' }}"
        kind: ClusterIssuer
        group: cert-manager.io
  oauthIdentityProviders:
    identityProviders:
      - name: "{{ cluster_sso['console_sso_label'] }}"
        mappingMethod: claim
        type: OpenID
        openID:
          issuer: "{{ cluster_sso['sso_url'] }}/realms/{{ cluster_sso['client_realm'] }}"
          clientID: "{{ cluster_sso['client_id'] }}"
          clientSecret:
            name: oidc-client-secret
          extraScopes: [profile]
          claims:
            preferredUsername: [preferred_username, email]
            name: [name]
            email: [email]
            groups: [groups]
{% if metal %}
  # ---- Install definition read by AutoShift's cluster-install policies on the hub ----
  networking:
    clusterNetwork: {cidr: 10.128.0.0/14, hostPrefix: 23}
    machineNetwork: {cidr: "{{ metal_platform_config.node_prefix }}"}
    serviceNetwork: [172.30.0.0/16]
    # The 1G ports only PXE-boot the host; the cluster lives on VLANs of the 10G bond.
    interfaces:
      eno1: {type: ethernet, name: eno1, state: up, ipv4: disabled, ipv6: disabled}
      eno2: {type: ethernet, name: eno2, state: up, ipv4: disabled, ipv6: disabled}
      ten0: {type: ethernet, name: enp131s0f0, state: up, mtu: {{ metal_platform_config.ceph_mtu }}, ipv4: disabled, ipv6: disabled}
      ten1: {type: ethernet, name: enp131s0f1, state: up, mtu: {{ metal_platform_config.ceph_mtu }}, ipv4: disabled, ipv6: disabled}
      data: {type: bond, name: bond1, state: up, mode: active-backup, miimon: 100, mtu: {{ metal_platform_config.ceph_mtu }}, ports: [enp131s0f0, enp131s0f1], ipv4: disabled, ipv6: disabled}
      machine: {type: vlan, name: "bond1.{{ metal_platform_config.machine_vlan }}", state: up, id: {{ metal_platform_config.machine_vlan }}, base: bond1, mtu: {{ metal_platform_config.machine_mtu }}, ipv4: static, ipv6: disabled}
      storage: {type: vlan, name: "bond1.{{ metal_platform_config.ceph_vlan }}", state: up, id: {{ metal_platform_config.ceph_vlan }}, base: bond1, mtu: {{ metal_platform_config.ceph_mtu }}, ipv4: static, ipv6: disabled}
    routes:
      default: {destination: 0.0.0.0/0, gateway: "{{ metal_platform_config.node_gateway }}", interface: "bond1.{{ metal_platform_config.machine_vlan }}"}
    dns:
      servers: {{ cluster_dns_servers | to_json }}
  hosts:
{% for h in metal_selected_hosts %}
{% set hw = metal_host_pool[h] %}
    master-{{ loop.index0 }}:
      # physical host: {{ h }}
      role: {{ 'master' if loop.index0 < metal_platform_config.cluster_sizes[cluster_size].controller_count else 'worker' }}
      bmcIP: "{{ hw.bmc_address }}"
      bmcPrefix: {{ hw.bmc_prefix }}
      bmcEndpoint: ''
      bootMode: {{ hw.boot_mode }}
      bootMACAddress: "{{ hw.boot_mac }}"
      primaryMac: "{{ hw.data.values() | first }}"
      rootDeviceHints: {{ hw.root_device_hints | to_json }}
      interfaces:
{% for name, mac in (hw.lom | combine(hw.data)).items() %}
        - {macAddress: "{{ mac }}", name: {{ name }}}
{% endfor %}
      networking:
        interfaces:
          machine: {ipv4: {addresses: [{ip: "{{ metal_node_addresses[h] | ansible.netcommon.ipaddr('address') }}", prefixLength: {{ metal_node_addresses[h] | ansible.netcommon.ipaddr('prefix') }}}]}}
          storage: {ipv4: {addresses: [{ip: "{{ hw.ceph_address }}", prefixLength: {{ metal_platform_config.ceph_prefix_length }}}]}}
{% endfor %}
  clusterInstall:
    createCluster: 'true'
    platform: baremetal
    baseDomain: "{{ base_domain }}"
    openshiftVersion: "{{ mapped_cluster_version }}"
    controlPlaneAgents: {{ metal_platform_config.cluster_sizes[cluster_size].controller_count }}
{% if not is_sno %}
    apiVip: "{{ internal_api_vip }}"
    ingressVip: "{{ internal_ingress_vip }}"
    mastersSchedulable: {{ (metal_platform_config.cluster_sizes[cluster_size].worker_count == 0) | to_json }}
{% endif %}
    pullSecretRef: default-pull-secret
    bmcCredentialRef: default-bmc-cred
    secretSourceNamespace: cluster-install-secrets
    sshPublicKey: "{{ cluster_ssh_pubkey }}"
    ntpSources: {{ cluster_ntp_sources | to_json }}
{% endif %}
